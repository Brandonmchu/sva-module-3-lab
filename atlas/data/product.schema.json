{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Group-trip product data",
  "type": "object",
  "required": [
    "version",
    "trips",
    "travelers",
    "activities",
    "responses",
    "expenses",
    "settlements"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "trips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trip"
      }
    },
    "travelers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/traveler"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/response"
      }
    },
    "expenses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expense"
      }
    },
    "settlements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/settlement"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "trip": {
      "type": "object",
      "required": [
        "id",
        "title",
        "destination",
        "start_date",
        "end_date",
        "budget_per_person",
        "currency",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "budget_per_person": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "planning",
            "confirmed",
            "cancelled"
          ]
        }
      },
      "additionalProperties": true
    },
    "traveler": {
      "type": "object",
      "required": [
        "id",
        "trip_id",
        "name",
        "available_from",
        "available_to",
        "budget",
        "interests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "trip_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "available_from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "available_to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "budget": {
          "type": "number",
          "minimum": 0
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "activity": {
      "type": "object",
      "required": [
        "id",
        "trip_id",
        "title",
        "date",
        "category",
        "estimated_cost_per_person",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "trip_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "estimated_cost_per_person": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "removed"
          ]
        }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": [
        "id",
        "trip_id",
        "traveler_id",
        "activity_id",
        "vote",
        "comment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "trip_id": {
          "type": "string",
          "minLength": 1
        },
        "traveler_id": {
          "type": "string",
          "minLength": 1
        },
        "activity_id": {
          "type": "string",
          "minLength": 1
        },
        "vote": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "maybe"
          ]
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "expense": {
      "type": "object",
      "required": [
        "id",
        "trip_id",
        "title",
        "date",
        "category",
        "amount",
        "paid_by_traveler_id",
        "split_mode",
        "splits"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "trip_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
        "category": { "type": "string", "minLength": 1 },
        "amount": { "type": "number", "minimum": 0 },
        "paid_by_traveler_id": { "type": "string", "minLength": 1 },
        "split_mode": { "type": "string", "enum": ["amount", "percentage"] },
        "splits": {
          "type": "array",
          "items": { "$ref": "#/$defs/expenseSplit" }
        }
      },
      "additionalProperties": true
    },
    "expenseSplit": {
      "type": "object",
      "required": ["traveler_id", "share", "amount"],
      "properties": {
        "traveler_id": { "type": "string", "minLength": 1 },
        "share": { "type": "number", "minimum": 0 },
        "amount": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "settlement": {
      "type": "object",
      "required": [
        "id",
        "trip_id",
        "from_traveler_id",
        "to_traveler_id",
        "amount",
        "date",
        "note"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "trip_id": { "type": "string", "minLength": 1 },
        "from_traveler_id": { "type": "string", "minLength": 1 },
        "to_traveler_id": { "type": "string", "minLength": 1 },
        "amount": { "type": "number", "minimum": 0 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
